# Frontend (Vite)
# Leave empty in production so the browser uses relative /api routes.
VITE_API_BASE_URL=http://localhost:3001

# PayPal Smart Buttons (public client id)
# Sandbox: https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# ---- Server only (never prefix with VITE_) ----
# Same PayPal app as above; secret is required to create/verify captures.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
# sandbox | live
PAYPAL_MODE=sandbox

# Durable order storage on Vercel (recommended). Local server.mjs uses data/orders.json.
# BLOB_READ_WRITE_TOKEN=

# Required to list orders via GET /api/orders
ORDERS_ADMIN_TOKEN=change-me-to-a-long-random-string

# Local/dev only — never enable on production Vercel
# ALLOW_UNVERIFIED_ORDERS=1
# ALLOW_PUBLIC_ORDER_LIST=1
