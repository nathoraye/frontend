# Frontend (Vite)
# Leave empty in production so the browser uses relative /api routes.
VITE_API_BASE_URL=http://localhost:3001

# Optional. Hosted Stripe Checkout does not need a publishable key in the browser.
# Keep a test pk_ if you still want Payment Element experiments locally.
# https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ---- Server only (never prefix with VITE_) ----
# Stripe secret key — required to create Checkout Sessions and verify webhooks.
# Use a test-mode sk_test_ / rk_test_ key for local and Vercel Preview.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Signing secret from Workbench → Webhooks for /api/stripe/webhook
# Local CLI: stripe listen --forward-to localhost:3001/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Public site origin used for Checkout success/cancel URLs (no trailing slash).
# On Vercel this can be left unset; the API falls back to VERCEL_URL or the
# browser Origin sent when creating the session.
# PUBLIC_APP_URL=https://westvinylstudio.com

# Durable order storage on Vercel (recommended). Local server.mjs uses data/orders.json.
# BLOB_READ_WRITE_TOKEN=

# Required to list/open jobs via GET /api/orders and /jobs on production.
# Stays on the server. The jobs board signs in with the username and password below
# and receives a session; do not paste this token into the page.
ORDERS_ADMIN_TOKEN=change-me-to-a-long-random-string

# Shop sign-in for /admin/orders and /jobs. Server only — never prefix with VITE_.
# JOBS_ADMIN_USERNAME=
# JOBS_ADMIN_PASSWORD=

# Temporary live smoke-test Checkout total in cents (server only). Unset restores retail.
# 100 = A$1.00 for the whole session (single line item; shipping is omitted).
# Remove/unset this variable and redeploy to charge the current retail pricing again.
# SMOKE_CHECKOUT_AMOUNT_CENTS=100

# Local/dev only — never enable on production Vercel
# ALLOW_UNVERIFIED_ORDERS=1
# ALLOW_PUBLIC_ORDER_LIST=1

# Artwork. Leave both unset to use keyless Pollinations.
# When AI_GATEWAY_API_KEY is set and IMAGE_PROVIDER is unset, /api/generate
# uses Vercel AI Gateway. Server only — never prefix with VITE_.
# Create the key in the Vercel dashboard under AI Gateway.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_IMAGE_MODEL=bfl/flux-2-klein-4b
# IMAGE_PROVIDER=gateway
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# HUGGINGFACE_API_TOKEN=
# HUGGINGFACE_IMAGE_MODEL=

# ---- Ads and analytics (optional) ----
# Leave every variable below unset to disable tracking: no tags, no pixels,
# and no server calls to Google or Meta.
#
# Browser values are baked in at build time. Restart `npm run dev` after edits.
# Set the same names on Vercel project frontendwvs for Production (and Preview
# if you want to test there). Do not prefix the server values with VITE_.

# GA4 Admin → Data streams → Web → Measurement ID (looks like G-XXXXXXXX).
# Sends page views and ecommerce events to that GA4 stream.
# Defaults to G-0NP4GQGMRB; set this to override the studio GA4 property.
# VITE_GA4_MEASUREMENT_ID=G-0NP4GQGMRB

# Google Ads → Goals → Conversions → your purchase conversion → Tag setup.
# Loads the Google tag for Ads. Paste the AW-######### id, or the full conversion id AW-#########/label.
# Optional. If you only import the GA4 purchase event into Google Ads, leave
# this unset. Setting a label AND importing the same GA4 purchase will double count.
# VITE_GOOGLE_ADS_ID=

# Only when VITE_GOOGLE_ADS_ID is the AW- id without a slash.
# Google Ads → that conversion → Tag setup → Event snippet → the label after the slash.
# VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Meta Events Manager → Data sources → your pixel → Pixel ID (digits only).
# VITE_META_PIXEL_ID=

# Server purchase events (Checkout webhook). Same Measurement ID as the browser.
# GA4 Admin → Data streams → your web stream.
# GA4_MEASUREMENT_ID=

# GA4 Admin → Data streams → your web stream → Measurement Protocol API secrets → Create.
# GA4_API_SECRET=

# Same pixel id as VITE_META_PIXEL_ID. Events Manager → Data sources.
# META_PIXEL_ID=

# Events Manager → your pixel → Settings → Conversions API → Generate access token.
# META_CAPI_ACCESS_TOKEN=

# Optional. Events Manager → Test events → confirm the server received a purchase.
# Leave unset in production so live events are not marked as tests.
# META_TEST_EVENT_CODE=

# Optional. Set to 1 to mark Measurement Protocol hits as debug (GA4 DebugView).
# GA4_DEBUG=
